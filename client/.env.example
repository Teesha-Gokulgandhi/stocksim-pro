# Client Environment Configuration Template
# Copy this file to .env and configure your values

# Backend API Base URL
# Local Development: http://localhost:5000/api
# Production: https://api.yourdomain.com/api or https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Optional Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
