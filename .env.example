# Docker Compose Environment Template
# Copy this file to .env before running `docker compose up`

# MongoDB Atlas URI (or leave blank to use the embedded MongoDB container)
MONGO_URI=mongodb://mongo:27017/stocksim-pro

# Authentication Secret
JWT_SECRET=production_secret_key_change_me_to_a_secure_random_string

# Frontend Access URLs
CLIENT_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Google Gemini AI — Market Copilot Intelligence
GEMINI_API_KEY=your_gemini_api_key_here
