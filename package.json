{
  "name": "stocksim-pro",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mern",
    "mern-stack",
    "stock-market",
    "stock-trading",
    "trading-platform",
    "stock-simulator",
    "paper-trading",
    "react",
    "nodejs",
    "express",
    "mongodb",
    "yahoo-finance",
    "candlestick-charts",
    "docker",
    "aws-ec2",
    "nginx"
  ],
  "author": "Teesha Gokulgandhi",
  "license": "MIT",
  "description": "Production-grade Full-Stack MERN real-time stock market simulator and trading platform featuring live Yahoo Finance quotes, interactive candlestick charts, dual INR/USD portfolios, automated TP/SL orders, Docker containerization, and AWS EC2 deployment.",
  "homepage": "https://stocksimpro.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teesha-Gokulgandhi/stocksim-pro.git"
