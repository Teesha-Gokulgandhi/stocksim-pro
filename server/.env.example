# Server Environment Configuration Template
# Copy this file to .env and configure your values

PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://127.0.0.1:27017/stocksim-pro
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/stocksim-pro?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/stocksim-pro

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d

# Cache & Performance (Yahoo Finance Quote Cache TTL in seconds)
QUOTE_CACHE_TTL_SECONDS=60

# CORS Allowed Origins (Comma-separated URLs)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Optional Google OAuth Authentication
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# Reverse Proxy Configuration (set to 1 if deploying behind Nginx / AWS ALB / Render)
TRUST_PROXY_HOPS=0

# Google Gemini AI — Market Copilot Intelligence (Free at aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
